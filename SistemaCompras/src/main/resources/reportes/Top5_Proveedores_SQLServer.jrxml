<!-- Created with Jaspersoft Studio version 7.0.8.final using JasperReports Library version 7.0.8-6f896111  -->
<jasperReport name="Top5_Proveedores" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d1e41f8c-e087-4fab-83de-26f7c86b37a7">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<parameter name="FechaInicio" class="java.sql.Date"/>
	<parameter name="FechaFin" class="java.sql.Date"/>
	<query language="SQL"><![CDATA[SELECT TOP 5
    p.nombreComercial AS Proveedor,
    COUNT(ad.AdjudicacionID) AS Pedidos,
    SUM(ad.cantidadFinal * ad.precioAcordado) AS Monto
FROM Adjudicacion_Detalle ad
INNER JOIN Adjudicacion adj ON ad.AdjudicacionID = adj.AdjudicacionID
INNER JOIN Proveedor p ON ad.ProveedorID = p.ProveedorID
WHERE adj.fechaResolucion BETWEEN $P{FechaInicio} AND $P{FechaFin}
GROUP BY p.nombreComercial
ORDER BY Monto DESC;]]></query>
	<field name="Proveedor" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Proveedor"/>
		<property name="com.jaspersoft.studio.field.label" value="Proveedor"/>
	</field>
	<field name="Pedidos" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="Pedidos"/>
		<property name="com.jaspersoft.studio.field.label" value="Pedidos"/>
	</field>
	<field name="Monto" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="Monto"/>
		<property name="com.jaspersoft.studio.field.label" value="Monto"/>
	</field>
	<variable name="SumaTotal" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{Monto}]]></expression>
	</variable>
