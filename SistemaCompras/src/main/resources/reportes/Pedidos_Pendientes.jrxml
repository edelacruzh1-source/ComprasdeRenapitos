<jasperReport name="Pedidos_Pendientes" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ef695972-3626-4f0f-ae51-3b0a10accd87">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<query language="SQL"><![CDATA[SELECT 
    p.PedidoID,
    s.Codigo AS CodigoSucursal,
    d.nombre AS Departamento,
    a.codigo AS CodigoArticulo,
    a.nombre AS Articulo,
    p.cantidad,
    p.fechaSolicitud,
    p.fechaNecesidad
FROM dbo.Pedido_Interno p
INNER JOIN dbo.Departamento d ON p.DepartamentoID = d.DepartamentoID
INNER JOIN dbo.Sucursal s ON d.SucursalID = s.SucursalID
INNER JOIN dbo.Articulo a ON p.ArticuloID = a.ArticuloID
LEFT JOIN dbo.Orden_Pedido op ON p.PedidoID = op.PedidoID
WHERE op.PedidoID IS NULL
ORDER BY p.fechaSolicitud;]]></query>
