			<element kind="textField" uuid="f06b15c1-f5b9-4630-8c21-e08da1592474" x="370" y="0" width="185" height="21" hTextAlign="Center">
				<property name="com.jaspersoft.studio.unit.width" value="px"/>
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<expression><![CDATA[$F{PrecioAnterior} == null 
    ? "—" 
    : new java.math.BigDecimal(
        ((($F{precioUnitario}.doubleValue() - $F{PrecioAnterior}.doubleValue()) / $F{PrecioAnterior}.doubleValue()) * 100)
      ).setScale(2, java.math.RoundingMode.HALF_UP) + "%"]]></expression>
			</element>
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
