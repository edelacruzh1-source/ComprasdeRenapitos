<!-- Created with Jaspersoft Studio version 7.0.8.final using JasperReports Library version 7.0.8-6f896111  -->
<jasperReport name="Variacion_Precio" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d74e6783-b69e-44de-96ad-42c064efa18d">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="ArticuloID" class="java.lang.Integer"/>
	<parameter name="ProveedorID" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT 
    a.nombre AS Articulo,
    p.nombreComercial AS Proveedor,
    op.precioUnitario,
    op.fechaOferta,
    LAG(op.precioUnitario) OVER (ORDER BY op.fechaOferta) AS PrecioAnterior
FROM Oferta_Proveedor op
INNER JOIN Proveedor p ON op.ProveedorID = p.ProveedorID
INNER JOIN Proveedor_Articulo pa ON pa.ProveedorID = op.ProveedorID
INNER JOIN Articulo a ON pa.ArticuloID = a.ArticuloID
WHERE a.ArticuloID = $P{ArticuloID}
  AND p.ProveedorID = $P{ProveedorID}
ORDER BY op.fechaOferta;]]></query>
	<field name="Articulo" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Articulo"/>
		<property name="com.jaspersoft.studio.field.label" value="Articulo"/>
	</field>
	<field name="Proveedor" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Proveedor"/>
		<property name="com.jaspersoft.studio.field.label" value="Proveedor"/>
	</field>
	<field name="precioUnitario" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="precioUnitario"/>
		<property name="com.jaspersoft.studio.field.label" value="precioUnitario"/>
	</field>
	<field name="fechaOferta" class="java.sql.Date">
		<property name="com.jaspersoft.studio.field.name" value="fechaOferta"/>
		<property name="com.jaspersoft.studio.field.label" value="fechaOferta"/>
	</field>
	<field name="PrecioAnterior" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="PrecioAnterior"/>
		<property name="com.jaspersoft.studio.field.label" value="PrecioAnterior"/>
	</field>
	<variable name="PrecioMin" calculation="Lowest" class="java.math.BigDecimal">
		<expression><![CDATA[$F{precioUnitario}]]></expression>
	</variable>
	<variable name="PrecioProm" calculation="Average" class="java.lang.Double">
		<expression><![CDATA[$F{precioUnitario}]]></expression>
	</variable>
	<variable name="PrecioMax" calculation="Highest" class="java.math.BigDecimal">
		<expression><![CDATA[$F{precioUnitario}]]></expression>
	</variable>
