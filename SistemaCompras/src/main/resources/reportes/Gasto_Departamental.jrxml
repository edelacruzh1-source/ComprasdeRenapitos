<jasperReport name="Gasto_Departamental" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e1a7031f-e795-448c-927c-53f74340087f">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<parameter name="SucursalID" class="java.lang.Integer"/>
	<parameter name="Anio" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT 
    s.Codigo AS Sucursal,
    d.nombre AS Departamento,
    COUNT(DISTINCT ad.PedidoID) AS TotalPedidos,
    SUM(ad.cantidadFinal * ad.precioAcordado) AS GastoTotal
FROM Adjudicacion_Detalle ad
INNER JOIN Pedido_Interno pi ON ad.PedidoID = pi.PedidoID
INNER JOIN Departamento d ON pi.DepartamentoID = d.DepartamentoID
INNER JOIN Sucursal s ON d.SucursalID = s.SucursalID
INNER JOIN Adjudicacion adj ON ad.AdjudicacionID = adj.AdjudicacionID
WHERE s.SucursalID = $P{SucursalID}
  AND YEAR(adj.fechaResolucion) = $P{Anio}
GROUP BY s.Codigo, d.nombre
ORDER BY GastoTotal DESC;]]></query>
	<field name="Sucursal" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Sucursal"/>
		<property name="com.jaspersoft.studio.field.label" value="Sucursal"/>
	</field>
	<field name="Departamento" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Departamento"/>
		<property name="com.jaspersoft.studio.field.label" value="Departamento"/>
	</field>
	<field name="TotalPedidos" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="TotalPedidos"/>
		<property name="com.jaspersoft.studio.field.label" value="TotalPedidos"/>
	</field>
	<field name="GastoTotal" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="GastoTotal"/>
		<property name="com.jaspersoft.studio.field.label" value="GastoTotal"/>
	</field>
	<variable name="SumaTotal" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GastoTotal}]]></expression>
	</variable>
