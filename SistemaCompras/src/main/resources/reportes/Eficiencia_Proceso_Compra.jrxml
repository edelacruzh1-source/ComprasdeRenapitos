<jasperReport name="Eficiencia_Proceso_Compra" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b5602267-73e7-451d-bd07-fec4ee63865f">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<query language="SQL"><![CDATA[SELECT 
    o.OrdenID,
    o.descripcion AS Orden,
    o.fechaCreacion,
    adj.fechaResolucion,
    DATEDIFF(DAY, o.fechaCreacion, adj.fechaResolucion) AS DiasTranscurridos
FROM Orden_Compra o
INNER JOIN Adjudicacion adj ON o.OrdenID = adj.OrdenID
ORDER BY DiasTranscurridos DESC;]]></query>
	<field name="OrdenID" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="OrdenID"/>
		<property name="com.jaspersoft.studio.field.label" value="OrdenID"/>
	</field>
	<field name="Orden" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Orden"/>
		<property name="com.jaspersoft.studio.field.label" value="Orden"/>
	</field>
	<field name="fechaCreacion" class="java.sql.Date">
		<property name="com.jaspersoft.studio.field.name" value="fechaCreacion"/>
		<property name="com.jaspersoft.studio.field.label" value="fechaCreacion"/>
	</field>
	<field name="fechaResolucion" class="java.sql.Date">
		<property name="com.jaspersoft.studio.field.name" value="fechaResolucion"/>
		<property name="com.jaspersoft.studio.field.label" value="fechaResolucion"/>
	</field>
	<field name="DiasTranscurridos" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="DiasTranscurridos"/>
		<property name="com.jaspersoft.studio.field.label" value="DiasTranscurridos"/>
	</field>
	<variable name="PromedioDias" calculation="Average" class="java.lang.Double">
		<expression><![CDATA[$F{DiasTranscurridos}]]></expression>
	</variable>
