<jasperReport name="Analisis_Oferta_Por_Orden" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="48e18930-5c67-417e-9f86-cb1b4ddf8806">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<parameter name="OrdenID" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT 
    o.OrdenID,
    o.descripcion AS Orden,
    op.PedidoID AS Pedido,
    p.nombreComercial AS Proveedor,
    op.precioUnitario AS Precio,
    op.fechaOferta,
    CASE 
        WHEN op.precioUnitario = (
            SELECT MIN(op2.precioUnitario) 
            FROM Oferta_Proveedor op2 
            WHERE op2.PedidoID = op.PedidoID
        ) THEN 'MEJOR OPCIÓN'
        ELSE ''
    END AS Estado
FROM Oferta_Proveedor op
INNER JOIN Orden_Pedido ordp ON op.PedidoID = ordp.PedidoID
INNER JOIN Orden_Compra o ON ordp.OrdenID = o.OrdenID
INNER JOIN Proveedor p ON op.ProveedorID = p.ProveedorID
WHERE o.OrdenID = $P{OrdenID}
ORDER BY o.OrdenID, op.PedidoID, op.precioUnitario;]]></query>
